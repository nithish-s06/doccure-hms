{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "4f7b807d-1128-42c8-bad8-06670f8f311c"
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
               "node_modules/lucide-static/font/lucide.css",
              "src/assets/fonts/phosphor-icons/duotone/style.css",
              "src/assets/fonts/phosphor-icons/regular/style.css",
              "src/assets/fonts/phosphor-icons/fill/style.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/@tabler/icons-webfont/dist/tabler-icons.css",
              "node_modules/lightgallery/css/lightgallery.css",
              "node_modules/iconoir/css/iconoir.css",
              "node_modules/lightgallery/css/lg-zoom.css",
              "node_modules/glightbox/dist/css/glightbox.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular:build:production"
            },
            "development": {
              "buildTarget": "angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
